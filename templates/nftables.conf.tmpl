#!/usr/sbin/nft -f
# Managed by pi5-router install.sh — do not edit by hand, edit router.conf instead.
flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        iifname "__AP_WIFI_IF__" icmp type { echo-request, destination-unreachable, time-exceeded } accept
        iifname "__AP_WIFI_IF__" udp dport { 53, 67 } accept
        iifname "__AP_WIFI_IF__" tcp dport { 53, __SSH_PORT__, __RDP_PORT__, __DASHBOARD_PORT__ } accept

        # No accept rules for __ETH_IF__ / the wifi uplink (the hotel-facing interfaces) on
        # purpose: anything unsolicited arriving there is silently dropped, not rejected, so
        # the Pi does not respond to port scans or pings from the hotel side.
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop

        iifname "__AP_WIFI_IF__" oifname @uplinks accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }

    # __ETH_IF__ and __VPN_IF__ are fixed for the life of an install; whichever USB wifi
    # adapter is the active uplink is not -- any number can be plugged in, hot-swapped, or
    # chosen from the dashboard's adapter picker, so its membership here is maintained live by
    # dashboard/app.py (apply_uplink_selection) via separate `nft flush`/`add element` calls
    # after this file has already loaded, never by re-running this file itself. That distinction
    # actually matters here, not just style: combining this set's inline `elements = {...}`
    # initializer with a flush+add in the *same* nft transaction segfaults nft 1.1.3 (verified in
    # an isolated netns) -- loading this file once, then mutating the set via later separate `nft`
    # invocations, does not.
    set uplinks {
        type ifname
        elements = { "__ETH_IF__", "__VPN_IF__" }
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat;
        oifname @uplinks masquerade
    }

    set uplinks {
        type ifname
        elements = { "__ETH_IF__", "__VPN_IF__" }
    }
}

# VPN policy routing: empty until a client (or "all clients") is opted in via
# the dashboard's VPN card. Marked packets get picked up by an `ip rule` that
# wg-quick's own PostUp/PreDown install alongside the tunnel itself (see
# dashboard/app.py), so this table has nothing to do with whether the tunnel
# exists -- it only decides *whose* traffic gets marked for it. Client-to-
# client traffic never reaches here at all: hostapd relays it directly
# between stations on __AP_WIFI_IF__ (ap_isolate is unset, i.e. off), so it
# never enters this forward/mangle path regardless of VPN mode.
table ip vpn {
    set vpn_clients {
        type ipv4_addr
    }

    chain vpn_mark {
        type filter hook prerouting priority mangle; policy accept;
    }
}
